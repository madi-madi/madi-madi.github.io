<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text"><office:font-face-decls><style:font-face style:name="Liberation Sans" svg:font-family="Liberation Sans, Arial, sans-serif"/></office:font-face-decls><office:styles><style:style style:name="Name" style:family="paragraph" style:parent-style-name="Standard"><style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.06cm" fo:text-align="left" fo:line-height="100%"/><style:text-properties fo:font-size="18pt" fo:font-weight="bold" style:font-name="Liberation Sans" fo:font-family="Liberation Sans, Arial, sans-serif"/></style:style><style:style style:name="Role" style:family="paragraph" style:parent-style-name="Standard"><style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.08cm" fo:text-align="left" fo:line-height="100%"/><style:text-properties fo:font-size="10.5pt" fo:font-weight="normal" style:font-name="Liberation Sans" fo:font-family="Liberation Sans, Arial, sans-serif"/></style:style><style:style style:name="Contact" style:family="paragraph" style:parent-style-name="Standard"><style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.02cm" fo:text-align="left" fo:line-height="100%"/><style:text-properties fo:font-size="9pt" fo:font-weight="normal" style:font-name="Liberation Sans" fo:font-family="Liberation Sans, Arial, sans-serif"/></style:style><style:style style:name="Contact2" style:family="paragraph" style:parent-style-name="Standard"><style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.30cm" fo:text-align="left" fo:line-height="100%"/><style:text-properties fo:font-size="9pt" fo:font-weight="normal" style:font-name="Liberation Sans" fo:font-family="Liberation Sans, Arial, sans-serif"/></style:style><style:style style:name="H2" style:family="paragraph" style:parent-style-name="Standard"><style:paragraph-properties fo:margin-top="0.30cm" fo:margin-bottom="0.12cm" fo:text-align="left" fo:line-height="100%" fo:border-bottom="0.5pt solid #000000" fo:padding-bottom="0.04cm"/><style:text-properties fo:font-size="10.5pt" fo:font-weight="bold" style:font-name="Liberation Sans" fo:font-family="Liberation Sans, Arial, sans-serif"/></style:style><style:style style:name="H3" style:family="paragraph" style:parent-style-name="Standard"><style:paragraph-properties fo:margin-top="0.22cm" fo:margin-bottom="0.02cm" fo:text-align="left" fo:line-height="100%"/><style:text-properties fo:font-size="10pt" fo:font-weight="bold" style:font-name="Liberation Sans" fo:font-family="Liberation Sans, Arial, sans-serif"/></style:style><style:style style:name="Meta" style:family="paragraph" style:parent-style-name="Standard"><style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.08cm" fo:text-align="left" fo:line-height="100%"/><style:text-properties fo:font-size="9pt" fo:font-weight="normal" style:font-name="Liberation Sans" fo:font-family="Liberation Sans, Arial, sans-serif"/></style:style><style:style style:name="Proj" style:family="paragraph" style:parent-style-name="Standard"><style:paragraph-properties fo:margin-top="0.14cm" fo:margin-bottom="0.04cm" fo:text-align="left" fo:line-height="100%"/><style:text-properties fo:font-size="10pt" fo:font-weight="bold" style:font-name="Liberation Sans" fo:font-family="Liberation Sans, Arial, sans-serif"/></style:style><style:style style:name="Body" style:family="paragraph" style:parent-style-name="Standard"><style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.06cm" fo:text-align="justify" fo:line-height="104%"/><style:text-properties fo:font-size="10pt" fo:font-weight="normal" style:font-name="Liberation Sans" fo:font-family="Liberation Sans, Arial, sans-serif"/></style:style><style:style style:name="Skill" style:family="paragraph" style:parent-style-name="Standard"><style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.05cm" fo:text-align="left" fo:line-height="104%"/><style:text-properties fo:font-size="10pt" fo:font-weight="normal" style:font-name="Liberation Sans" fo:font-family="Liberation Sans, Arial, sans-serif"/></style:style><style:style style:name="Bul" style:family="paragraph" style:parent-style-name="Standard"><style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.05cm" fo:text-align="left" fo:line-height="104%" fo:margin-left="0.45cm" fo:text-indent="-0.45cm"/><style:text-properties fo:font-size="10pt" fo:font-weight="normal" style:font-name="Liberation Sans" fo:font-family="Liberation Sans, Arial, sans-serif"/></style:style><style:style style:name="B" style:family="text"><style:text-properties fo:font-weight="bold"/></style:style></office:styles><office:automatic-styles><style:page-layout style:name="pm1"><style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="1.15cm" fo:margin-bottom="1.15cm" fo:margin-left="1.5cm" fo:margin-right="1.5cm"/></style:page-layout></office:automatic-styles><office:master-styles><style:master-page style:name="Standard" style:page-layout-name="pm1"/></office:master-styles><office:body><office:text><text:p text:style-name="Name">IBRAHIM SALAMA MADI</text:p><text:p text:style-name="Role"><text:span text:style-name="B">Full Stack Web Developer</text:span> — Laravel, Vue.js, Elasticsearch</text:p><text:p text:style-name="Contact">ibrahim.s.m.2010@gmail.com | +970 597 866 994 | Gaza, Palestine</text:p><text:p text:style-name="Contact2">linkedin.com/in/madi-madi | github.com/madi-madi | madi-madi.github.io</text:p><text:p text:style-name="H2">PROFESSIONAL SUMMARY</text:p><text:p text:style-name="Body">Full stack developer with 9 years building production web platforms, 7 of them on Laravel. Spent five years as a core developer on ArabsStock, an Arabic stock media marketplace holding over 1 million assets, where I owned full-text and faceted search in Elasticsearch, the contributor ingest pipeline, and the RabbitMQ queues behind both. Strong across the stack — Vue.js and Nuxt.js on the front end, PHP, Python, MySQL, Redis, Docker and Kubernetes behind it — working to OOP and SOLID principles, writing PHPUnit tests, reviewing pull requests and documenting what I ship. Available immediately for remote or on-site roles.</text:p><text:p text:style-name="H2">TECHNICAL SKILLS</text:p><text:p text:style-name="Skill"><text:span text:style-name="B">Languages: </text:span>PHP, Python, JavaScript, SQL, HTML5, CSS3</text:p><text:p text:style-name="Skill"><text:span text:style-name="B">Frameworks: </text:span>Laravel, Vue.js, Nuxt.js, Inertia.js, Livewire</text:p><text:p text:style-name="Skill"><text:span text:style-name="B">Backend &amp; Architecture: </text:span>REST APIs, GraphQL, WebSockets, MVC, OOP, SOLID, design patterns, Eloquent ORM, database migrations, modular architecture</text:p><text:p text:style-name="Skill"><text:span text:style-name="B">Testing &amp; Quality: </text:span>PHPUnit, unit and feature testing, code review, refactoring, technical documentation</text:p><text:p text:style-name="Skill"><text:span text:style-name="B">Databases &amp; Search: </text:span>MySQL, Redis, Elasticsearch</text:p><text:p text:style-name="Skill"><text:span text:style-name="B">Messaging &amp; Queues: </text:span>RabbitMQ, Laravel Queues, FCM push notifications</text:p><text:p text:style-name="Skill"><text:span text:style-name="B">Media Processing: </text:span>Python (Pillow, ImageMagick), FFmpeg, image and video pipelines</text:p><text:p text:style-name="Skill"><text:span text:style-name="B">DevOps &amp; Cloud: </text:span>Docker, Kubernetes, Nginx, Linux, Git, CI/CD, AWS (S3, CloudFront)</text:p><text:p text:style-name="Skill"><text:span text:style-name="B">Payments: </text:span>HyperPay, Stripe, PayPal</text:p><text:p text:style-name="Skill"><text:span text:style-name="B">Practices: </text:span>Agile/Scrum, mentoring, application security, SEO optimization, AI-assisted development (Claude Code, GitHub Copilot)</text:p><text:p text:style-name="H2">PROFESSIONAL EXPERIENCE</text:p><text:p text:style-name="H3">Full Stack Developer</text:p><text:p text:style-name="Meta">Kenan Technology | Gaza, Palestine | January 2021 – September 2026</text:p><text:p text:style-name="Proj">ArabsStock — Arabic stock media marketplace (1M+ assets)</text:p><text:p text:style-name="Bul">• Implemented Elasticsearch full-text and faceted search across 1M+ media assets, adding Arabic normalization of diacritics, hamza and ta-marbuta so unvocalized queries match vocalized titles.</text:p><text:p text:style-name="Bul">• Designed the contributor upload portal for photos, vectors, video and audio, with metadata entry and an editorial review workflow before publication.</text:p><text:p text:style-name="Bul">• Engineered Python media-processing pipelines for resizing, watermarking, vector rasterization and FFmpeg transcoding, dispatched as RabbitMQ jobs so uploads never block an HTTP request.</text:p><text:p text:style-name="Bul">• Co-architected and built the admin dashboard covering users, assets, orders, payouts and financial reporting.</text:p><text:p text:style-name="Bul">• Integrated HyperPay, Stripe and PayPal for subscription and per-asset purchases, plus FCM push notifications.</text:p><text:p text:style-name="Bul">• Optimized the public website for organic search: sitemap generation, structured data, lazy loading and Redis caching.</text:p><text:p text:style-name="Bul">• Maintained Docker and Kubernetes deployments on a CI/CD pipeline running on Linux behind Nginx, with media served from AWS S3 and CloudFront.</text:p><text:p text:style-name="Bul">• Wrote PHPUnit unit and feature tests, reviewed colleagues' pull requests, mentored junior developers and documented service boundaries.</text:p><text:p text:style-name="Proj">ESG — Enterprise governance platform</text:p><text:p text:style-name="Bul">• Developed Laravel backend modules for ESG reporting and compliance workflows, covering recurring disclosure cycles, evidence attachments and multi-step approval chains.</text:p><text:p text:style-name="H3">Web Developer (Contract)</text:p><text:p text:style-name="Meta">Accessline | October 2022 – December 2022</text:p><text:p text:style-name="Bul">• Built a nutrition and wellness platform in Laravel and Vue.js, delivering client onboarding, plan management and service-delivery workflows.</text:p><text:p text:style-name="H3">Web Developer</text:p><text:p text:style-name="Meta">Apex for IT Solutions | Gaza, Palestine | June 2020 – August 2020</text:p><text:p text:style-name="Bul">• Developed OSRAPP with Laravel, REST APIs and Firebase Cloud Messaging.</text:p><text:p text:style-name="Bul">• Delivered MY HOME with HyperPay payment gateway integration and Firebase push notifications.</text:p><text:p text:style-name="Bul">• Extended MYCN using Laravel and the Metronic admin theme.</text:p><text:p text:style-name="H3">Web Developer (Contract)</text:p><text:p text:style-name="Meta">Rasd | June 2020 – August 2020</text:p><text:p text:style-name="Bul">• Built a social listening and analytics platform integrating the Facebook, Twitter and Awario APIs, normalizing three different response shapes into a single real-time mention feed.</text:p><text:p text:style-name="H3">Web Developer</text:p><text:p text:style-name="Meta">Effects for Consultations and Development | Gaza, Palestine | February 2019 – April 2020</text:p><text:p text:style-name="Bul">• GCC: delivered a data-visualization dashboard with Gantt charts, calendars and Vuex state management.</text:p><text:p text:style-name="Bul">• HADEEDAPP: implemented geo-location and Google Maps integration for field-staff tracking.</text:p><text:p text:style-name="Bul">• QSOFT: delivered a WordPress solution with custom PHP backend logic.</text:p><text:p text:style-name="H3">Web Developer</text:p><text:p text:style-name="Meta">Space | Gaza, Palestine | July 2017 – December 2017</text:p><text:p text:style-name="Bul">• Developed a cultural web platform for the Future Society for Culture and Development using PHP, MySQL and WordPress.</text:p><text:p text:style-name="H2">EDUCATION</text:p><text:p text:style-name="H3">Bachelor's Degree in Information Technology and Communications</text:p><text:p text:style-name="Meta">Al-Quds Open University | 2013 – 2016</text:p><text:p text:style-name="H2">LANGUAGES</text:p><text:p text:style-name="Skill">Arabic: Native. English: Professional working proficiency.</text:p></office:text></office:body></office:document>